# 训练决策模型：对话的下一步动作全部由它决定，没有规则回退路径。
# 决策模型在本机 Ollama 运行；首次用 start_dev.py --model-package 导入包内或共享位置的 ZIP。
POLICY_API_BASE_URL=http://127.0.0.1:11434
POLICY_API_MODEL=policy-qwen3-8b:latest
POLICY_API_TIMEOUT=60
# 本机 Ollama 不需要密钥。
POLICY_API_KEY=
VISION_PROVIDER=emotiefflib
# Real camera analysis is the default. Explicit mock mode is only for tests without the model.
VISION_ENGINE=onnx
VISION_MODEL=enet_b0_8_va_mtl

# The unified environment includes ASR dependencies; set ASR_PROVIDER=sensevoice to enable.
ASR_PROVIDER=disabled
ASR_MODEL=iic/SenseVoiceSmall
ASR_MODEL_REVISION=master
# Team environment uses CUDA 12.8 PyTorch; set ASR_DEVICE=cuda:0 for NVIDIA GPU inference.
ASR_DEVICE=cpu
ASR_LANGUAGE=auto
ASR_MAX_UPLOAD_MB=10
ASR_MAX_DURATION_SECONDS=60
ASR_TIMEOUT_SECONDS=60
ASR_MAX_PENDING=4
ASR_CPU_THREADS=4

# Assistant reply TTS API. Keep the real key in an ignored local .env.
# TTS_PROVIDER 默认 cosyvoice；配置的 provider 不可用时自动退到 edge（需要
# edge-tts>=7.3.1，7.2.8 及更早的合成握手稳定 403）。
# 实际生效的 provider 与回退情况见 GET /api/tts/status（configured_provider /
# fallback_reason）；POST /api/tts/probe 真合成一次，是唯一可信的通断自检。
TTS_PROVIDER=cosyvoice
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longyingtao_v3
TTS_TIMEOUT_SECONDS=30

# --- 视觉证据与多模态一致性的可调阈值 ---
# 这些是原型参数，不是校准过的概率；完整清单与含义见 backend/core/vision_thresholds.py。
# 表情能否被说出口的置信度门槛。8 分类模型输出常落 0.3~0.8，设 0.8 会让采纳路径
# 几乎不可达（实测连续 14 轮一次都没采纳）。
VISION_ACK_MIN_CONFIDENCE=0.6
# 一条外观证据要成立，至少要有几帧、人脸帧占比下限、以及这帧离发言结束不能超过
# 多少毫秒（超时算"太旧"，不再拿来描述当前状态）。
VISION_ACK_MIN_FRAMES=3
VISION_ACK_MIN_FRAME_RATIO=0.7
VISION_ACK_MAX_STALENESS_MS=2500
# 提过一次外观后的冷却回合数，以及从第几轮起才允许提及。
VISION_ACK_COOLDOWN_TURNS=4
VISION_ACK_FIRST_TURN=2
# YuNet 人脸权重文件的位置覆盖项。留空即用 backend/vision/weights/ 下的默认文件；
# 首次使用会自动下载一次（约 227 KB），也可以先手动备好：
#   python -m backend.vision.face_weights
# 拿不到权重不会报错，实时链路会自动退回 Haar 级联（暗光下漏检更多）。
# 别的机器上离线跑时，请先把权重放到这里指定的路径。
VISION_YUNET_MODEL=
# 只凭连续效价说一句整体语气：阈值以下算"看不出方向"，low 只往关心方向说。
VISION_ACK_TONE_VALENCE=0.2
VISION_ACK_TONE_DIRECTION=low
# 逐帧落盘（阈值重校用）：给一个目录就打开，留空即关闭。文件里是每帧的情绪、
# 置信度与效价（外加每行开头的来源描述），只在真实会话上临时打开。
# 目录请放在仓库之外（例如仓库同级的 ../vision_dump）；放进仓库时用 vision_dump/
# 这个名字，已在 .gitignore 里，别把校准数据提交上去。
# 重校口径见 backend/core/vision_thresholds.py 的模块说明。
VISION_FRAME_DUMP_DIR=
# 会话级一致性分档与单句核对门槛；分数只描述两路方向差，不代表诊断置信度。
CONSISTENCY_MIN_PAIRS=2
CONSISTENCY_HIGH_SCORE=80
CONSISTENCY_MODERATE_SCORE=60
CONSISTENCY_DISCORDANCE_GAP=0.4
# 单句核对的方向策略：face_negative 只在"文字正向、人脸负向"时核对，不拿摄像头的
# 猜测去反驳学生自己的诉苦；both 为对称判定。
CONSISTENCY_DISCORDANCE_DIRECTION=face_negative

# --- Dialogue Agent + Evaluation Agent + Healing Agent ---
# 真实 Key 只放在本地 .env，不要提交。评估时会发送对话原文和视觉结构化状态。
# 对话与评估各用一把独立密钥；治愈 Agent 与对话 Agent 共用。
# 进入陪伴时会发送已保存评估、明确背景及当前会话文字；不发送原始音视频。
# 接入兼容服务时，地址和模型名必须对应该服务；评估的 API_STYLE 单独按服务能力配置。
DEEPSEEK_DIALOGUE_API_KEY=
DEEPSEEK_EVALUATION_API_KEY=
# 通用兜底密钥：上面两个都为空时才使用。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.5
# 对话回复生成使用以下两个参数。
DEEPSEEK_MAX_TOKENS=300
DEEPSEEK_TIMEOUT=60
# 综合评估使用以下参数；需要输出完整的 11 小项判断。
DEEPSEEK_API_STYLE=responses
DEEPSEEK_STRUCTURED_OUTPUT=json_schema
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=2

# --- CORS 白名单 ---
# 默认放行 React 前端 5173 与新学生端 5174；联调心晴静态原型时补上 8766。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8766,http://127.0.0.1:8766

# --- Safety Agent 部署地区 ---
# Safety 只下发与该地区一致的**已核实**热线；号码由后端注入，模型不得自造。
# 留空或填 unknown = 不下发任何号码（fail-closed，启动时会打印告警）。
# 注册表当前只有 CN 的 12356（全国心理援助热线，来源见 backend/safety/hotlines.py）。
# 演示"心理安全支持"场景时需要它，否则回复里不会出现热线号码。
SAFETY_DEPLOYMENT_REGION=CN

