LLM_PROVIDER=mock
LLM_API_KEY=
# 训练决策模型：对话的下一步动作全部由它决定，没有规则回退路径。
# 只连接本机回环地址，可通过本机端口转发接入模型服务。
POLICY_API_BASE_URL=http://127.0.0.1:8001
POLICY_API_MODEL=policy-model
POLICY_API_TIMEOUT=30
# 如果本机模型服务要求认证，在本地 .env 填写，不要提交真实密钥。
POLICY_API_KEY=
VISION_PROVIDER=mock
# Set VISION_PROVIDER=emotiefflib after installing requirements-vision.txt.
VISION_ENGINE=onnx
VISION_MODEL=enet_b0_8_va_mtl

# Optional whole-recording ASR. Install requirements-audio.txt before enabling.
ASR_PROVIDER=disabled
ASR_MODEL=iic/SenseVoiceSmall
ASR_MODEL_REVISION=master
# cpu works without CUDA; use cuda:0 with a matching CUDA PyTorch installation.
ASR_DEVICE=cpu
ASR_LANGUAGE=auto
ASR_MAX_UPLOAD_MB=10
ASR_MAX_DURATION_SECONDS=60
ASR_TIMEOUT_SECONDS=60
ASR_MAX_PENDING=4
ASR_CPU_THREADS=4

# --- Dialogue Agent + Evaluation Agent (DeepSeek) ---
# 真实 Key 只放在本地 .env，不要提交。评估时会发送对话原文和视觉结构化状态。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.5
# 对话回复生成使用以下两个参数。
DEEPSEEK_MAX_TOKENS=300
DEEPSEEK_TIMEOUT=60
# 综合评估使用以下参数；需要输出完整的 11 小项判断。
DEEPSEEK_API_STYLE=responses
DEEPSEEK_STRUCTURED_OUTPUT=json_schema
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=2
