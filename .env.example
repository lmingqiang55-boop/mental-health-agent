LLM_PROVIDER=mock
LLM_API_KEY=

# Independent extractor for /api/assessment; values are read from the process environment.
ASSESSMENT_EXTRACTOR=mock
# Drives both halves of the question pipeline: the decider (which topic and why)
# and the generator (the wording). `mock` is offline and for local runs/tests only.
ASSESSMENT_QUESTION_GENERATOR=mock
# For a cloud or local OpenAI-compatible chat completions endpoint:
# ASSESSMENT_EXTRACTOR=openai_compatible
# ASSESSMENT_QUESTION_GENERATOR=openai_compatible
# ASSESSMENT_LLM_BASE_URL=http://127.0.0.1:8001/v1
# ASSESSMENT_LLM_MODEL=your-model-id
# ASSESSMENT_LLM_API_KEY=
# Decision and question phrasing can use different OpenAI-compatible models.
# Omitted values fall back to ASSESSMENT_LLM_* (also used by the extractor).
# ASSESSMENT_DECIDER_BASE_URL=https://api.deepseek.com
# ASSESSMENT_DECIDER_MODEL=deepseek-v4-pro
# ASSESSMENT_DECIDER_API_KEY=
# ASSESSMENT_DECIDER_THINKING=disabled
# ASSESSMENT_GENERATOR_BASE_URL=https://api.deepseek.com
# ASSESSMENT_GENERATOR_MODEL=deepseek-flash
# ASSESSMENT_GENERATOR_API_KEY=
# ASSESSMENT_GENERATOR_THINKING=disabled
# DeepSeek V4.1 Flash: base URL=https://api.deepseek.com, model=deepseek-flash
# ASSESSMENT_LLM_THINKING=disabled
