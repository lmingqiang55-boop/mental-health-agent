LLM_PROVIDER=mock
LLM_API_KEY=
VISION_PROVIDER=mock
# Set VISION_PROVIDER=emotiefflib after installing requirements-vision.txt.
VISION_ENGINE=onnx
VISION_MODEL=enet_b0_8_va_mtl

# --- Dialogue Agent (DeepSeek) ---
# 真实 Key 只放在本地 .env，不要提交。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.5
DEEPSEEK_MAX_TOKENS=300
DEEPSEEK_TIMEOUT=60
